# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Neon Postgres -----------------------------------------------------------
# Pulled automatically by `neon env pull` (or `neon link` / `neon checkout`).
# DATABASE_URL is the pooled connection used by app code (neon-http driver).
# DATABASE_URL_UNPOOLED is the direct connection, for seed/transaction scripts.
NEON_BRANCH=main
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Clerk auth --------------------------------------------------------------
# Pulled automatically by `clerk env pull`. Never expose CLERK_SECRET_KEY
# to client code.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Cloudflare R2 (asset storage) -------------------------------------------
# NOT required until Phase 3 (the props pipeline). Create at:
#   dash.cloudflare.com -> R2 -> Create bucket, then "Manage API tokens".
# The bucket needs CORS allowing PUT from your app origin and GET from *,
# or presigned uploads fail with an opaque error.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=blockworld-assets
# Public read origin: a pub-*.r2.dev domain or your own custom domain.
NEXT_PUBLIC_R2_PUBLIC_URL=

# --- Meshy (props pipeline, scripts/meshy-batch.ts) --------------------------
# Get a key at meshy.ai -> dashboard -> API. Free tier can't download output;
# generating the real catalog needs Pro ($20/mo, 1000 credits). Leave unset to
# use Meshy's published dummy test key instead, which returns a mock
# placeholder model for free and proves the pipeline without spending credits.
MESHY_API_KEY=

# --- Multiplayer room server (Phase 5, optional) -----------------------------
# Points the app at the Colyseus server in server/. LEAVE UNSET and the app
# behaves exactly as it did before multiplayer: no socket, no peers, no UI.
# Local: ws://localhost:2567 (with `cd server && npm run dev`).
NEXT_PUBLIC_MULTIPLAYER_URL=

# How the app recognises the room server, which has no database credentials of
# its own and reads and writes worlds through /api/worlds/:id/sync. Must be the
# same value as the server's MULTIPLAYER_SECRET. Unset locks that route
# completely — including for the room server, which then never saves.
# Generate one with: openssl rand -base64 32
MULTIPLAYER_SECRET=

# --- Contact form (optional) -------------------------------------------------
# A Formspree form id, from formspree.io -> your form -> the endpoint's last
# segment (https://formspree.io/f/XXXXXXXX -> XXXXXXXX).
#
# LEAVE UNSET and /contact shows the email address instead of a form. That is
# deliberate: a form posting to a placeholder endpoint accepts every message
# and delivers none, and the sender has no way to tell. An address that works
# beats a form that looks like it does.
#
# After setting it, submit the form once yourself and confirm the mail arrives.
NEXT_PUBLIC_FORMSPREE_ID=

# --- Community (optional) ----------------------------------------------------
# The Discord invite behind the header link, the footer block, the /discord
# redirect and the one line offered after a personal best.
#
# LEAVE UNSET and the invite in lib/discord.ts is used, which is the one the
# spec shipped — the site is never left with a link that goes nowhere. A value
# that is not an https discord.gg / discord.com URL is rejected and the default
# used instead, because a typo here would silently repoint every one of those
# surfaces at once.
#
# Note this is inlined at build time, like every NEXT_PUBLIC_ variable, so
# changing it still needs a redeploy. /discord is what makes the invite one
# edit rather than four.
NEXT_PUBLIC_DISCORD_INVITE=

# --- Plays and likes ---------------------------------------------------------
# Nothing to set. The counters live in the same Neon database as runs, worlds
# and players (tables game_stats, game_likes, game_plays_daily, rate_hits), so
# they need DATABASE_URL and nothing else.
#
# The engagement spec calls for Upstash Redis and two more variables; it was
# written on the stated assumption that this game had no server-side
# persistence, and offered to be rewritten if it did. It does. See the note on
# `gameStats` in lib/db/schema.ts.

# --- The Android app ---------------------------------------------------------
# SHA-256 fingerprints of every certificate allowed to claim this domain,
# comma-separated. Colons optional, case ignored; anything that is not 32 hex
# bytes is dropped rather than served.
#
# This is what /.well-known/assetlinks.json publishes, and it is what decides
# whether the installed app opens fullscreen or with a browser address bar
# pinned across the top of the HUD.
#
# LEAVE UNSET and the file is served with an empty fingerprint list, which is
# valid JSON and verifies nothing. That is the correct state before the first
# build exists.
#
# **There are normally two values here, and forgetting the second is the usual
# way this goes wrong.** The APK you sign locally carries your *upload* key;
# the same app delivered by Google Play is re-signed by Google with an *app
# signing* key you never hold. Both belong in this list:
#
#   - local:  npm run android:fingerprint
#   - Play:   Play Console -> Test and release -> Setup -> App signing
#
# The Play value does not exist until the first bundle has been uploaded, which
# is why this is a variable rather than a constant in the code.
ANDROID_CERT_FINGERPRINTS=

# The Play Store listing, once the app has cleared production review.
#
# LEAVE UNSET until it is live. /download shows a "Get it on Google Play" card
# only when this is set, because a store link that 404s reads as the app having
# been pulled — worse than no link at all.
#
# Inlined at build time like every NEXT_PUBLIC_ variable, so setting it needs a
# redeploy.
NEXT_PUBLIC_PLAY_STORE_URL=
