# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Neon Postgres -----------------------------------------------------------
# Pulled automatically by `neon env pull` (or `neon link` / `neon checkout`).
# DATABASE_URL is the pooled connection used by app code (neon-http driver).
# DATABASE_URL_UNPOOLED is the direct connection, for seed/transaction scripts.
NEON_BRANCH=main
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Clerk auth --------------------------------------------------------------
# Pulled automatically by `clerk env pull`. Never expose CLERK_SECRET_KEY
# to client code.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Cloudflare R2 (asset storage) -------------------------------------------
# NOT required until Phase 3 (the props pipeline). Create at:
#   dash.cloudflare.com -> R2 -> Create bucket, then "Manage API tokens".
# The bucket needs CORS allowing PUT from your app origin and GET from *,
# or presigned uploads fail with an opaque error.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=blockworld-assets
# Public read origin: a pub-*.r2.dev domain or your own custom domain.
NEXT_PUBLIC_R2_PUBLIC_URL=

# --- Meshy (props pipeline, scripts/meshy-batch.ts) --------------------------
# Get a key at meshy.ai -> dashboard -> API. Free tier can't download output;
# generating the real catalog needs Pro ($20/mo, 1000 credits). Leave unset to
# use Meshy's published dummy test key instead, which returns a mock
# placeholder model for free and proves the pipeline without spending credits.
MESHY_API_KEY=

# --- Multiplayer room server (Phase 5, optional) -----------------------------
# Points the app at the Colyseus server in server/. LEAVE UNSET and the app
# behaves exactly as it did before multiplayer: no socket, no peers, no UI.
# Local: ws://localhost:2567 (with `cd server && npm run dev`).
NEXT_PUBLIC_MULTIPLAYER_URL=

# How the app recognises the room server, which has no database credentials of
# its own and reads and writes worlds through /api/worlds/:id/sync. Must be the
# same value as the server's MULTIPLAYER_SECRET. Unset locks that route
# completely — including for the room server, which then never saves.
# Generate one with: openssl rand -base64 32
MULTIPLAYER_SECRET=
