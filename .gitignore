# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the key-less template is meant to be committed.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.neon

# props pipeline: raw Meshy downloads are intermediate, not shipped —
# public/props/ (the optimized output) is what's committed and served.
/assets/raw-props/

# Same rule for characters: `assets/raw-characters/` holds the raw rig
# downloads that `npm run chars:optimize` reads, and public/characters/ is the
# optimized output that actually ships. 948K in, 184K out.
/assets/raw-characters/

# And for the bike: assets/raw-bikes/ holds the FBX export (and the archive it
# came in) that `npm run bike:import` reads; public/bikes/ is the 20k-triangle,
# five-material GLB it produces, and that is what ships.
/assets/raw-bikes/

# And for block surfaces: assets/raw-textures/ holds the 1K Poly Haven maps
# that `npm run textures:fetch` downloads and `npm run textures` reads;
# public/textures/generated/ is the 256px strip it produces, and that ships.
/assets/raw-textures/

# And for UI art: assets/raw-ui/ holds the generated icons (3-4 MB each, on a
# chroma ground, watermarked) that `npm run ui:art` keys, crops and shrinks;
# public/ui/ is the 4-7 KB WebP set it produces, and that ships.
/assets/raw-ui/

# The Android build. `android/twa-manifest.json` and `android/README.md` are
# the repo's half of it — the rest is either generated by Bubblewrap on demand
# or must never be in git at all.
#
# `release.keystore` is the second kind. An APK signed with a different key
# cannot upgrade one signed with this one: Android refuses the install and the
# only way out is uninstalling, which takes the player's local data with it.
# Committing it would also hand anyone with repo access the ability to sign
# something that upgrades an install in place. Keep it, back it up, off git.
/android/*
!/android/twa-manifest.json
!/android/README.md

# The Capacitor build, which takes the OPPOSITE rule to the TWA above, on
# purpose.
#
# Bubblewrap regenerates its whole project from `twa-manifest.json`, so that
# project is an output and ignoring it loses nothing. A Capacitor native
# project is not an output: `MainActivity.java` carries the back-button
# handler, `app/build.gradle` carries the signing config and R8, and
# `proguard-rules.pro` carries the keep rules — all hand-written, none of them
# reproducible by `npx cap add android`, which would overwrite them. Capacitor
# documents the native project as source for exactly this reason. So it is
# committed, and only the secrets and the build outputs are not.
/capacitor-android/release.keystore
/capacitor-android/keystore.properties
/capacitor-android/.gradle/
/capacitor-android/build/
/capacitor-android/app/build/
/capacitor-android/capacitor-cordova-android-plugins/build/
/capacitor-android/local.properties
/capacitor-android/.idea/
/capacitor-android/*.apk
/capacitor-android/*.aab

# Android Studio / IntelliJ project settings. Machine-local — the SDK paths,
# window layout and caches in here belong to whoever opened the project, not
# to the project.
/.idea/

# Any signing key or its passwords, wherever it ends up — not only the two
# known paths above. A key in git can sign an update that installs over the
# real app.
*.jks
*.keystore
keystore.properties
