{
  "name": "blockworld",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test src/**/*.test.ts",
    "sky:preview": "node --import tsx scripts/render-sky.ts",
    "light:check": "node --import tsx scripts/light-check.mts",
    "courses:check": "node --import tsx scripts/course-check.ts",
    "floors:backfill": "node --import tsx scripts/backfill-floors.ts",
    "covers": "node --import tsx scripts/generate-covers.ts",
    "icons:generate": "node --import tsx scripts/generate-icons.ts",
    "chars:optimize": "node --import tsx scripts/optimize-characters.ts",
    "props:generate": "node --import tsx scripts/meshy-batch.ts",
    "props:optimize": "node --import tsx scripts/optimize-props.ts",
    "props:upload": "node --import tsx scripts/upload-props.ts",
    "peers:soak": "node --import tsx scripts/peer-soak.ts",
    "bike:import": "node --import tsx scripts/import-bike.ts",
    "bike:preview": "node --import tsx scripts/preview-bike.ts",
    "textures:fetch": "node --import tsx scripts/fetch-textures.ts",
    "textures": "node --import tsx scripts/build-textures.ts",
    "courses:stats": "node --import tsx scripts/course-stats.ts",
    "android:update": "cd android && npx @bubblewrap/cli update",
    "android:build": "cd android && npx @bubblewrap/cli build",
    "android:release": "node --import tsx scripts/android-release.ts",
    "android:fingerprint": "keytool -list -v -keystore android/release.keystore -alias specdrivengames",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "cap:debug": "cap sync android && cd capacitor-android && gradlew.bat assembleDebug",
    "cap:build": "cap sync android && cd capacitor-android && gradlew.bat assembleRelease bundleRelease",
    "cap:fingerprint": "keytool -list -v -keystore capacitor-android/release.keystore -alias specdrivengames"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@clerk/nextjs": "^7.8.3",
    "@colyseus/sdk": "^0.18.2",
    "@neondatabase/serverless": "^1.1.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@react-three/rapier": "^2.2.0",
    "@vercel/speed-insights": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "ecctrl": "^2.0.1",
    "leva": "^0.10.1",
    "nanoid": "^6.0.1",
    "next": "16.3.4",
    "postprocessing": "^6.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "dotenv": "^17.4.2",
    "draco3dgltf": "^1.5.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
