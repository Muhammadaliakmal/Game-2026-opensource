# Room server (Phase 5). Copy to .env for local runs.

# Port the Colyseus server binds.
PORT=2567

# The Next app the room reads worlds from (GET /api/worlds/:id).
APP_URL=http://localhost:3000

# Rooms refuse to authenticate anyone until Clerk verification lands in 5d.
# Set to 1 for local development ONLY — it lets any client join any room.
ALLOW_ANONYMOUS_ROOMS=0
