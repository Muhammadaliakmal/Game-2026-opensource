# Room server (Phase 5). Copy to .env for local runs.

# Port the Colyseus server binds.
PORT=2567

# The Next app the room reads worlds from and saves them back through.
APP_URL=http://localhost:3000

# --- Who may join (5d) ------------------------------------------------------
# The same Clerk secret key the app uses. The room verifies session tokens with
# it; without it, and without ALLOW_ANONYMOUS_ROOMS, every join is refused.
CLERK_SECRET_KEY=

# Optional. Origins whose tokens are accepted, as Clerk's `azp` claim, comma
# separated. Unset accepts any origin in the Clerk instance, which is fine for
# one app and worth tightening when there are two.
CLERK_AUTHORIZED_PARTIES=

# --- Reading and saving worlds (5d) -----------------------------------------
# Shared with the app's MULTIPLAYER_SECRET — it is how the app tells this
# process apart from a browser. Without it the room can still open public
# worlds and run a session, but private worlds are invisible to it and NOTHING
# IS EVER SAVED. Generate one with: openssl rand -base64 32
MULTIPLAYER_SECRET=

# --- Local development ------------------------------------------------------
# Treat every client as a signed-in editor, so a laptop with no Clerk keys can
# still build. Never set this anywhere real: it lets any client edit any world.
ALLOW_ANONYMOUS_ROOMS=0
